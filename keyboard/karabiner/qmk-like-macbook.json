        { "type": "basic", "from": { "key_code": "n", "modifiers": { "optional": ["any"] } }, "to": [{ "key_code": "6", "modifiers": ["left_shift"] }, { "key_code": "spacebar" }], "conditions": [{ "type": "variable_if", "name": "symbols_layer", "value": 1 }] },
        { "type": "basic", "from": { "key_code": "m", "modifiers": { "optional": ["any"] } }, "to": [{ "key_code": "quote" }, { "key_code": "spacebar" }], "conditions": [{ "type": "variable_if", "name": "symbols_layer", "value": 1 }] },
        { "type": "basic", "from": { "key_code": "comma", "modifiers": { "optional": ["any"] } }, "to": [{ "key_code": "grave_accent_and_tilde" }, { "key_code": "spacebar" }], "conditions": [{ "type": "variable_if", "name": "symbols_layer", "value": 1 }] },
        { "type": "basic", "from": { "key_code": "period", "modifiers": { "optional": ["any"] } }, "to": [{ "key_code": "0", "modifiers": ["right_option"] }], "conditions": [{ "type": "variable_if", "name": "symbols_layer", "value": 1 }] },
        { "type": "basic", "from": { "key_code": "slash", "modifiers": { "optional": ["any"] } }, "to": [{ "key_code": "9", "modifiers": ["right_option"] }], "conditions": [{ "type": "variable_if", "name": "symbols_layer", "value": 1 }] }
