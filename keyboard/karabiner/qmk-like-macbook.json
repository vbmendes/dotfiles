        { "type": "basic", "from": { "key_code": "h", "modifiers": { "mandatory": ["left_shift"], "optional": ["any"] } }, "to": [{ "key_code": "hyphen", "modifiers": [] }], "conditions": [{ "type": "variable_if", "name": "symbols_layer", "value": 1 }] },
